---
import BaseLayout from '../layouts/BaseLayout.astro';
// Break 100 Club — community pillar (IA v1). Content-light, philosophy-heavy.
// Copy source: ../../copy-draft-pages-v1.md section 5.
---

<BaseLayout
  title="Break 100 Club — Unda A Hundy"
  description="You're already a member. The only requirement is keeping showing up. First birdies, first pars, first rounds under 100, and every small improvement in between."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Break 100 Club</span>
      <h1>You're Already a Member.</h1>
      <p class="lede">
        The only requirement...<br />
        Keep showing up.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="prose prose--center">
        <p class="statement">The Break 100 Club isn't about membership cards.</p>
        <p>It's about the mindset.</p>
      </div>
    </div>
  </section>

  <section class="section--soft">
    <div class="container">
      <h2 style="text-align: center; margin-bottom: 32px;">We celebrate:</h2>
      <ul class="beat-list">
        <li>First birdies</li>
        <li>First pars</li>
        <li>First rounds under 100</li>
        <li>Personal bests</li>
        <li>Small improvements</li>
        <li>Golf friendships</li>
      </ul>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="prose prose--center">
        <p>
          Whether you shoot 89...
        </p>
        <p>
          ...or 119...
        </p>
        <p class="statement">If you're trying to get better... You belong here.</p>
      </div>
    </div>
  </section>

  <section class="cta-final">
    <div class="container">
      <h2>Join thousands of golfers chasing better, not perfect.</h2>
      <p>
        Get the first drop, behind-the-scenes content from the Road to 99, and the
        occasional bad-round story.
      </p>
      <div class="btn-row" style="justify-content: center;">
        <a
          class="btn btn--primary"
          href="mailto:hello@undaahundy.com?subject=Put%20me%20on%20the%20UAH%20list"
        >
          Get on the list
        </a>
        <a class="btn btn--ghost" href="/road-to-99">See the Road to 99</a>
      </div>
    </div>
  </section>
</BaseLayout>
