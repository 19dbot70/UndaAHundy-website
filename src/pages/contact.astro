---
import BaseLayout from '../layouts/BaseLayout.astro';
// Contact — form + social (IA v1: /contact/ = form + social).
// Copy source: ../../copy-draft-pages-v1.md section 6.
// The form posts to Netlify Forms. Attributes are written as raw strings so the
// data-netlify / netlify-honeypot markers survive the Astro transform.
const submitted = Astro.url.searchParams.has('submitted');
const reasons = [
  'Questions about an order?',
  'Wholesale inquiries?',
  'Content collaborations?',
  'Golf events?',
  'Media?',
];
const social = [
  { href: 'https://instagram.com/undaahundy', label: 'Instagram' },
  { href: 'https://tiktok.com/@undaahundy', label: 'TikTok' },
  { href: 'https://facebook.com/undaahundy', label: 'Facebook' },
];
---

<BaseLayout
  title="Contact — Unda A Hundy"
  description="Questions about an order, wholesale, collaborations, golf events, or media? We'd love to hear from you."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Let's Connect</h1>
      <p class="lede">
        We read everything that comes in, and we answer it like a person, not a ticket
        number. Tell us what's on your mind.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="split">
        <div>
          <h2>Send a message</h2>
          {submitted && (
            <div class="form-success">
              <strong>Message sent.</strong>
              Thanks for reaching out. You'll hear back from a human, usually within a
              couple of days.
            </div>
          )}
          <form
            class="form"
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/contact?submitted=true"
          >
            <input type="hidden" name="form-name" value="contact" />

            <p style="display:none;">
              <label>Don't fill this out if you're human: <input name="bot-field" /></label>
            </p>

            <div class="form-field">
              <label for="contact-name">Name</label>
              <input id="contact-name" name="name" type="text" required autocomplete="name" placeholder="Your name" />
            </div>

            <div class="form-field">
              <label for="contact-email">Email</label>
              <input id="contact-email" name="email" type="email" required autocomplete="email" placeholder="you@yourdomain.com" />
            </div>

            <div class="form-field">
              <label for="contact-message">Message</label>
              <textarea
                id="contact-message"
                name="message"
                required
                placeholder="What can we help with?"></textarea>
            </div>

            <button type="submit" class="btn btn--primary">Send message</button>
          </form>
          <p class="form-note">We read every message. No mailing lists, no sharing.</p>
          <p class="form-note" style="margin-top: 6px;">
            Something not working? Email <a href="mailto:hello@undaahundy.com">hello@undaahundy.com</a> directly.
          </p>
        </div>

        <aside>
          <h2>What can we help with?</h2>
          <ul class="link-list">
            {reasons.map((reason) => (
              <li>{reason}</li>
            ))}
          </ul>

          <h2 style="margin-top: 40px;">Email</h2>
          <p>
            <a href="mailto:hello@undaahundy.com">hello@undaahundy.com</a>
          </p>

          <h2 style="margin-top: 40px;">Social</h2>
          <ul class="link-list">
            {social.map((channel) => (
              <li><a href={channel.href} rel="noopener">{channel.label}</a></li>
            ))}
            <li>YouTube (coming soon)</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
